      </div>
    );
  }
  return (
    <div className="space-y-6">
      <header>
        <h1 className="text-2xl font-bold">Report a problem</h1>
        <p className="text-sm text-slate-600">Photo â†’ Location â†’ Confirm â†’ Submit</p>
      </header>
      <section className="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 className="mb-3 font-semibold">1. Take a photo</h2>
        {preview ? (
          <div className="space-y-3">
            <img src={preview} alt="Captured issue" className="w-full rounded-xl" />
            {analyzing && <div className="flex items-center gap-2 text-sm text-slate-600"><Loader2 className="h-4 w-4 animate-spin" />Analysing with Geminiâ€¦</div>}
            {aiError && <p className="text-sm text-amber-600">{aiError}</p>}
          </div>
        ) : (
          <label className="flex min-h-[180px] cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 p-6 text-slate-500">
            <Camera className="h-8 w-8" />
            <span className="font-medium">Tap to take or upload photo</span>
