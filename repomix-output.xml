          <button onClick={() => { if (!navigator.geolocation) return; navigator.geolocation.getCurrentPosition(p => onChange({ kind: "MAP_POINT", displayName: "My current location", coordinates: { type: "Point", coordinates: [p.coords.longitude, p.coords.latitude] }, source: "GPS + USER_CONFIRMATION" }), () => alert("Could not read GPS")); }} className="rounded-xl border border-slate-200 p-3 text-left text-sm"><MapPin className="mb-1 h-4 w-4 text-sky-600" />Use Current Location</button>
          <button onClick={() => onChange({ kind: "OUTDOOR", displayName: "Campus Outdoor", source: "USER_SELECTED_PLACE" })} className="rounded-xl border border-slate-200 p-3 text-left text-sm"><MapPin className="mb-1 h-4 w-4 text-sky-600" />Outdoor Area</button>
